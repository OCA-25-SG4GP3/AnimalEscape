# EditorConfig for Unity C# projects
# This works with Visual Studio, VS Code, and Rider
root = true

# All files
[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# C# files
[*.cs]
charset = utf-8-bom
indent_style = space
indent_size = 4
end_of_line = crlf

# Unity YAML files
[*.{unity,prefab,asset,mat,anim,controller,meta}]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = crlf
